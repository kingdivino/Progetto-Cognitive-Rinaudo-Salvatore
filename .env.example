# Copia questo file in ".env" (senza .example) e inserisci i tuoi valori reali.
# Il file ".env" non va mai caricato su git (è già escluso in .gitignore).

# Tavily — ricerca web. Chiave gratuita su https://tavily.com (sign up, no carta di credito)
TAVILY_API_KEY=

# LangSmith — osservabilità richiesta dalle specifiche. Chiave gratuita su https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=blogger-agent-hearthstone
# Se il tuo account LangSmith è in EU (controlla se fai login su eu.smith.langchain.com) scommenta la riga sotto,
# altrimenti le chiamate vanno di default sull'endpoint US e la chiave viene rifiutata con 403 Forbidden:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Neo4j Desktop — di default gira su questi valori, li cambi solo se personalizzi il setup del database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Ollama — di norma non serve una chiave (gira in locale), lascia così
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# Alternativa piu' capace testata per il nodo Planner (istruzioni piu' affidabili,
# meno errori di confronto numerico) - richiede prima 'ollama pull qwen3:14b'
# (~9GB VRAM a Q4_K_M): OLLAMA_MODEL=qwen3:14b
#
# OLLAMA_NUM_GPU (opzionale) - quanti layer del modello forzare sulla GPU. Nome
# fuorviante: NON e' il numero di GPU. Lasciare non impostata di norma (Ollama sceglie
# da solo, in modo prudente). Utile solo se con `ollama ps` mentre un run e' in corso
# si vede VRAM dedicata libera (Task Manager -> Prestazioni -> GPU): in quel caso
# Ollama non sta sfruttando tutta la VRAM disponibile. qwen3:14b ha 40 layer totali:
# provare OLLAMA_NUM_GPU=40 (tenta di mandarli tutti in VRAM); se il modello non parte
# o va in errore di memoria, scendere gradualmente (35, 30, ...) finche' non funziona.
# Esempio: OLLAMA_NUM_GPU=40
