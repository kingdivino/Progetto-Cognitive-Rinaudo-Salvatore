# Copia questo file in ".env" (senza .example) e inserisci i tuoi valori reali.
# Il file ".env" non va mai caricato su git (è già escluso in .gitignore).

# Tavily — ricerca web. Chiave gratuita su https://tavily.com (sign up, no carta di credito)
TAVILY_API_KEY=

# LangSmith — osservabilità richiesta dalle specifiche. Chiave gratuita su https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=blogger-agent-hearthstone

# Neo4j Desktop — di default gira su questi valori, li cambi solo se personalizzi il setup del database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Ollama — di norma non serve una chiave (gira in locale), lascia così
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
