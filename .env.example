# Copia questo file in ".env" (senza .example) e inserisci i tuoi valori reali.
# Il file ".env" non va mai caricato su git (è già escluso in .gitignore).

# Tavily — ricerca web. Chiave gratuita su https://tavily.com (sign up, no carta di credito)
TAVILY_API_KEY=

# LangSmith — osservabilità richiesta dalle specifiche. Chiave gratuita su https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=blogger-agent-hearthstone
# Se il tuo account LangSmith è in EU (controlla se fai login su eu.smith.langchain.com) scommenta la riga sotto,
# altrimenti le chiamate vanno di default sull'endpoint US e la chiave viene rifiutata con 403 Forbidden:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Neo4j Desktop — di default gira su questi valori, li cambi solo se personalizzi il setup del database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Ollama — di norma non serve una chiave (gira in locale), lascia così
OLLAMA_BASE_URL=http://localhost:11434
#
# Tre modelli testati, dal piu' veloce al piu' capace - con solo 4GB di VRAM dedicata
# (vedi nota hardware nella guida di progetto) e' un compromesso reale, non solo
# teorico: qwen3:14b segue le regole del prompt meglio ma impiega 20-40 minuti a run,
# troppo per iterare rapidamente durante lo sviluppo.
#   - OLLAMA_MODEL=llama3.1:8b   -> il piu' veloce (pochi secondi/minuti), ma il primo
#     testato ed e' quello con piu' errori di ragionamento osservati (vedi guida)
#   - OLLAMA_MODEL=qwen3:8b      -> via di mezzo CONSIGLIATA per iterare: stessa
#     famiglia/instruction-tuning di qwen3:14b (segue meglio le regole del prompt di
#     llama3.1:8b) ma circa la meta' dei parametri, quindi molto piu' veloce - va
#     abbinato a OLLAMA_REASONING=false sotto, altrimenti il "thinking" di default fa
#     perdere gran parte del vantaggio di velocita'. Richiede 'ollama pull qwen3:8b'.
#   - OLLAMA_MODEL=qwen3:14b     -> il piu' capace ma il piu' lento (10-40 min/run su
#     questo hardware) - da usare per verifiche finali, non per iterare
#   - OLLAMA_MODEL=qwen3:1.7b    -> ancora piu' leggero di qwen3:8b, per iterare quando
#     anche qwen3:8b e' troppo lento. ATTENZIONE (10/09/2026): mai validato in questo
#     progetto quanto affidabilmente segua le istruzioni su tool-calling e output
#     strutturato (Pydantic) - gia' un problema noto con qwen3:8b/14b (vedi guida di
#     progetto), un modello 5x piu' piccolo e' un salto di qualita' significativo.
#     Trattare i suoi risultati come test "la pipeline gira", non come verifica della
#     qualita' del ragionamento - per quello si torna a qwen3:8b o 14b. Richiede
#     comunque 'ollama pull qwen3:1.7b' prima del primo uso.
OLLAMA_MODEL=qwen3:8b
#
# OLLAMA_REASONING (opzionale) - alcuni modelli (tutta la famiglia Qwen3) fanno
# "thinking" interno esteso di default prima di rispondere, che aumenta molto la
# latenza indipendentemente dalla dimensione del modello (osservato: qwen3:14b oltre
# 10 minuti anche su prompt semplici). Impostare a "false" per disattivarlo (parametro
# nativo langchain-ollama ChatOllama(reasoning=...), mappato al parametro "think"
# dell'API Ollama). Lasciare non impostata per usare il default del modello.
OLLAMA_REASONING=false
#
# RESEARCH_POST_INDEX (opzionale, DI NORMA NON VA MESSA QUI, e dall'11/09/2026 non
# serve quasi mai piu') - indice (0-based) del post del piano che research_topic()
# deve elaborare quando viene chiamato in ISOLAMENTO (es. un test diretto di un solo
# nodo), al posto del primo (post_plan[0], usato di default in quel caso). Quando si
# passa dal GRAFO COMPLETO (build_graph(), usato da tutti i notebook 04+) questa
# variabile viene IGNORATA: il nodo select_next_post (src/agent/orchestrator.py) fa
# gia' avanzare il grafo su TUTTI i post del piano, uno alla volta, senza bisogno di
# scegliere un indice a mano - vedi guida di progetto. E' pensata come override
# MOMENTANEO per una singola esecuzione, non come impostazione persistente -
# normalmente si imposta al volo nel terminale invece di scriverla qui, es.:
#   set RESEARCH_POST_INDEX=3 && python -u notebooks/08_test_format.py      (cmd.exe)
#   $env:RESEARCH_POST_INDEX=3; python -u notebooks/08_test_format.py       (PowerShell)
# Se proprio si vuole un default persistente per più run di fila, si può scommentare
# e valorizzare la riga sotto - un valore fuori range o non numerico fa ripiegare sul
# comportamento di default (post_plan[0]):
# RESEARCH_POST_INDEX=0
#
# MAX_POSTS_TO_PROCESS (opzionale, aggiunta il 15/09/2026) - limita quanti post del
# piano vengono DAVVERO elaborati (research/draft/revisione/scrittura KG) in un
# singolo run del grafo completo, senza toccare quanti ne pianifica il Planner (resta
# sempre DEFAULT_N_POSTS=6 in src/agent/planner.py - NON abbassare quello, vedi il
# commento li' sul perche': una sequenza pianificata troppo corta e' probabile causa
# del voto non massimo del progetto di riferimento GymAssistant). Utile per velocizzare
# i test/la demo d'esame quando basta dimostrare la pipeline su 1-2 post invece che su
# tutti e 6 (ogni post costa realisticamente 10-15 minuti con qwen3:8b - un piano da 6
# puo' superare l'ora). Il piano completo, con la giustificazione di tutti i post,
# resta comunque visibile nel reasoning_trace e in post_plan - solo l'ESECUZIONE viene
# troncata. Non impostata = nessun limite (comportamento originale, elabora l'intero
# piano). Esempio, per fermarsi dopo 2 post:
#   set MAX_POSTS_TO_PROCESS=2 && python -u notebooks/10_test_kg_update.py    (cmd.exe)
#   $env:MAX_POSTS_TO_PROCESS=2; python -u notebooks/10_test_kg_update.py     (PowerShell)
# Se si vuole un default persistente, scommentare e valorizzare (un valore non
# numerico viene ignorato con un avviso nel reasoning_trace, non fa crashare il nodo):
# MAX_POSTS_TO_PROCESS=2
#
# OLLAMA_NUM_GPU (opzionale) - quanti layer del modello forzare sulla GPU. Nome
# fuorviante: NON e' il numero di GPU. Lasciare non impostata di norma (Ollama sceglie
# da solo, in modo prudente) - VALE ANCHE SE SI STA GIA' USANDO UN VALORE TARATO PER UN
# ALTRO MODELLO: il numero di layer "giusto" dipende dalla dimensione del modello
# attivo (OLLAMA_MODEL), un valore che funziona su un modello non si trasferisce
# automaticamente a un altro - vanno ritarati separatamente. ATTENZIONE - testato su
# questo hardware (4GB VRAM dedicata): un valore troppo alto non degrada la velocita'
# gradualmente, puo' far CRASHARE il driver CUDA o solo rallentare molto (probabile
# thrashing GPU/RAM condivisa) senza errore visibile - osservato entrambi i
# comportamenti con lo stesso valore (OLLAMA_NUM_GPU=30) su qwen3:8b in run diversi,
# segno che il valore era comunque al limite. Se si osserva VRAM dedicata libera con
# `ollama ps` durante un run (Task Manager -> Prestazioni -> GPU), aumentare
# gradualmente da un valore basso (es. parti da 10-15), non dal numero totale di layer.
# Valore confermato funzionante su questo hardware SOLO con qwen3:14b: OLLAMA_NUM_GPU=20
# (non testato/non riconfermato per altri modelli - lasciare non impostata finche' non
# si ritara per il modello effettivamente in uso).

# --- Fine-tuning (roadmap punto 6, 17/09/2026) ---
#
# FINETUNE_BASE_MODEL (opzionale) - modello base HuggingFace su cui applicare LoRA.
# Default: Qwen/Qwen2.5-1.5B-Instruct (stesso modello/template gia' usato nel
# progetto di riferimento GymAssistant - vedi guida di progetto). Usato da
# notebooks/12_finetune_baseline.py (zero-shot), 13_finetune_train.py,
# 14_finetune_evaluate.py e src/tools/power_level_tool.py - DEVE restare identico
# tra training e inferenza, altrimenti l'adapter LoRA non e' compatibile.
# FINETUNE_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
#
# LORA_RANK, LEARNING_RATE, NUM_EPOCHS, LORA_RUN_NAME (opzionali, per il model
# selection dello step 7) - lanciare notebooks/13_finetune_train.py piu' volte con
# combinazioni diverse (e un LORA_RUN_NAME diverso ogni volta, per non sovrascrivere
# i risultati precedenti), poi notebooks/13b_compare_runs.py per confrontarli sul
# validation set. Esempio:
#   set LORA_RANK=16 && set LORA_RUN_NAME=rank16_lr2e4 && python notebooks/13_finetune_train.py   (cmd.exe)
#   $env:LORA_RANK=16; $env:LORA_RUN_NAME="rank16_lr2e4"; python notebooks/13_finetune_train.py    (PowerShell)
# Default se non impostate: LORA_RANK=8, LEARNING_RATE=2e-4, NUM_EPOCHS=3, LORA_RUN_NAME=run.
# LORA_RANK=8
# LEARNING_RATE=2e-4
# NUM_EPOCHS=3
# LORA_RUN_NAME=run
#
# LORA_RUN_NAME e' anche letta da src/tools/power_level_tool.py per sapere quale
# adapter caricare in produzione (data/processed/finetune_powerlevel/<LORA_RUN_NAME>):
# impostarla alla configurazione scelta con 13b_compare_runs.py DOPO il confronto
# finale sul test set (14_finetune_evaluate.py), non durante gli esperimenti.
#
# NOTA HARDWARE (verificato il 17/09/2026): la build di torch installata in questo
# venv e' CPU-only (torch 2.13.0+cpu, nessun supporto CUDA) - stesso vincolo di VRAM
# limitata gia' documentato per Ollama sopra, ma qui il training/l'inferenza girano
# SOLO su CPU, piu' lenti di conseguenza. Non e' stato ancora misurato un tempo reale
# di training su questo hardware: lanciare una prima run di prova con pochi esempi
# per stimare il tempo prima di lanciare il confronto completo tra configurazioni.
