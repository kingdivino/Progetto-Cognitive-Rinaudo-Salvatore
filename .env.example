# Tavily — ricerca web.
TAVILY_API_KEY=

# LangSmith — osservabilità richiesta dalle specifiche.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=blogger-agent-hearthstone
# Per account in EU
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Neo4j Desktop
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Modelli testati: llama3.1:8b
# (piu' veloce, piu' errori di ragionamento), qwen3:8b (via di mezzo, abbinare a
# OLLAMA_REASONING=false), qwen3:14b (piu' capace, piu' lento), qwen3:1.7b (per
# iterare quando anche qwen3:8b e' lento).
OLLAMA_MODEL=qwen3:8b
# Disattiva il "thinking" interno di Qwen3 (aumenta molto la latenza). Non
# impostata = default del modello.
OLLAMA_REASONING=false
# OLLAMA_NUM_GPU (opzionale): layer forzati sulla GPU
# OLLAMA_NUM_GPU=30

# RESEARCH_POST_INDEX (opzionale): indice del post da elaborare
# quando si invoca research_topic() in isolamento, non tramite il grafo completo.
# RESEARCH_POST_INDEX=0

# MAX_POSTS_TO_PROCESS (opzionale): limita quanti post del piano vengono davvero
# elaborati in un run senza accorciare il piano
# pianificato dal Planner (resta DEFAULT_N_POSTS in planner.py). Non impostata =
# nessun limite.
# MAX_POSTS_TO_PROCESS=2

# --- Fine-tuning (notebooks 11-14) ---
# FINETUNE_BASE_MODEL (opzionale): modello base per LoRA.
# FINETUNE_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# LORA_RANK, LEARNING_RATE, NUM_EPOCHS, LORA_RUN_NAME (opzionali, model selection
# dello step 7)
# Default se non impostate: LORA_RANK=8, LEARNING_RATE=2e-4, NUM_EPOCHS=3, LORA_RUN_NAME=run.
# LORA_RANK=8
# LEARNING_RATE=2e-4
# NUM_EPOCHS=3
# LORA_RUN_NAME=run
