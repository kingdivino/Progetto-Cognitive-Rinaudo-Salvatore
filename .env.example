# Copia questo file in ".env" (senza .example) e inserisci i tuoi valori reali.
# Il file ".env" non va mai caricato su git (è già escluso in .gitignore).

# Tavily — ricerca web. Chiave gratuita su https://tavily.com (sign up, no carta di credito)
TAVILY_API_KEY=

# LangSmith — osservabilità richiesta dalle specifiche. Chiave gratuita su https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=blogger-agent-hearthstone
# Se il tuo account LangSmith è in EU (controlla se fai login su eu.smith.langchain.com) scommenta la riga sotto,
# altrimenti le chiamate vanno di default sull'endpoint US e la chiave viene rifiutata con 403 Forbidden:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Neo4j Desktop — di default gira su questi valori, li cambi solo se personalizzi il setup del database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Ollama — di norma non serve una chiave (gira in locale), lascia così
OLLAMA_BASE_URL=http://localhost:11434
#
# Tre modelli testati, dal piu' veloce al piu' capace - con solo 4GB di VRAM dedicata
# (vedi nota hardware nella guida di progetto) e' un compromesso reale, non solo
# teorico: qwen3:14b segue le regole del prompt meglio ma impiega 20-40 minuti a run,
# troppo per iterare rapidamente durante lo sviluppo.
#   - OLLAMA_MODEL=llama3.1:8b   -> il piu' veloce (pochi secondi/minuti), ma il primo
#     testato ed e' quello con piu' errori di ragionamento osservati (vedi guida)
#   - OLLAMA_MODEL=qwen3:8b      -> via di mezzo CONSIGLIATA per iterare: stessa
#     famiglia/instruction-tuning di qwen3:14b (segue meglio le regole del prompt di
#     llama3.1:8b) ma circa la meta' dei parametri, quindi molto piu' veloce - va
#     abbinato a OLLAMA_REASONING=false sotto, altrimenti il "thinking" di default fa
#     perdere gran parte del vantaggio di velocita'. Richiede 'ollama pull qwen3:8b'.
#   - OLLAMA_MODEL=qwen3:14b     -> il piu' capace ma il piu' lento (10-40 min/run su
#     questo hardware) - da usare per verifiche finali, non per iterare
OLLAMA_MODEL=qwen3:8b
#
# OLLAMA_REASONING (opzionale) - alcuni modelli (tutta la famiglia Qwen3) fanno
# "thinking" interno esteso di default prima di rispondere, che aumenta molto la
# latenza indipendentemente dalla dimensione del modello (osservato: qwen3:14b oltre
# 10 minuti anche su prompt semplici). Impostare a "false" per disattivarlo (parametro
# nativo langchain-ollama ChatOllama(reasoning=...), mappato al parametro "think"
# dell'API Ollama). Lasciare non impostata per usare il default del modello.
OLLAMA_REASONING=false
#
# OLLAMA_NUM_GPU (opzionale) - quanti layer del modello forzare sulla GPU. Nome
# fuorviante: NON e' il numero di GPU. Lasciare non impostata di norma (Ollama sceglie
# da solo, in modo prudente) - VALE ANCHE SE SI STA GIA' USANDO UN VALORE TARATO PER UN
# ALTRO MODELLO: il numero di layer "giusto" dipende dalla dimensione del modello
# attivo (OLLAMA_MODEL), un valore che funziona su un modello non si trasferisce
# automaticamente a un altro - vanno ritarati separatamente. ATTENZIONE - testato su
# questo hardware (4GB VRAM dedicata): un valore troppo alto non degrada la velocita'
# gradualmente, puo' far CRASHARE il driver CUDA o solo rallentare molto (probabile
# thrashing GPU/RAM condivisa) senza errore visibile - osservato entrambi i
# comportamenti con lo stesso valore (OLLAMA_NUM_GPU=30) su qwen3:8b in run diversi,
# segno che il valore era comunque al limite. Se si osserva VRAM dedicata libera con
# `ollama ps` durante un run (Task Manager -> Prestazioni -> GPU), aumentare
# gradualmente da un valore basso (es. parti da 10-15), non dal numero totale di layer.
# Valore confermato funzionante su questo hardware SOLO con qwen3:14b: OLLAMA_NUM_GPU=20
# (non testato/non riconfermato per altri modelli - lasciare non impostata finche' non
# si ritara per il modello effettivamente in uso).
